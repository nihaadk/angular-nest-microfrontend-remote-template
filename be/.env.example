# Copy to .env for local development: cp .env.example .env
# On Railway, set these as service Variables instead - .env is not deployed.

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:4201,http://localhost:4200

# PORT is set automatically by Railway in production; only needed locally
# if you want something other than the default 3001.
# PORT=3001
